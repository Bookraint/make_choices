page {
  height: 100%;
  background: #f6f0e6;
  color: #221e1a;
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

view,
text,
input,
button {
  box-sizing: border-box;
}

.dock {
  padding: 8rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(246, 240, 230, 0) 0%, #f6f0e6 26%);
}

.hint {
  display: block;
  margin-bottom: 14rpx;
  text-align: center;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: #8a8278;
}

.btn {
  width: 100%;
  height: 104rpx;
  margin: 0;
  padding: 0;
  line-height: 104rpx;
  border-radius: 999rpx;
  background: #d85a3a;
  color: #fffaf3;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-shadow: 0 16rpx 32rpx rgba(216, 90, 58, 0.28);
}

.btn::after {
  border: none;
}

.btn[disabled] {
  background: #e4d9cc;
  color: #9a9188;
  box-shadow: none;
}

.btn.busy[disabled] {
  opacity: 0.82;
  background: #d85a3a;
  color: #fffaf3;
  box-shadow: 0 16rpx 32rpx rgba(216, 90, 58, 0.22);
}

.btn-hover {
  background: #c44c30;
}

.slip {
  margin: 12rpx 40rpx 0;
  padding: 32rpx 36rpx 36rpx;
  border-radius: 36rpx;
  background: #fffaf3;
  box-shadow: 0 18rpx 40rpx rgba(48, 32, 20, 0.06);
  animation: slip-in 0.42s cubic-bezier(0.16, 1, 0.3, 1);
}

.slip-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #d85a3a;
}

.slip-text {
  display: block;
  margin-top: 10rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #221e1a;
  word-break: break-all;
}

.slip-text.xl {
  font-size: 64rpx;
}

.slip-text.lg {
  font-size: 48rpx;
}

.slip-text.md {
  font-size: 36rpx;
}

.prompt {
  padding: 36rpx 48rpx 12rpx;
  text-align: center;
  font-size: 28rpx;
  letter-spacing: 2rpx;
  color: #8a8278;
}

@keyframes slip-in {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
