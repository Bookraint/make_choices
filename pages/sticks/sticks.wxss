.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(80% 46% at 50% 30%, rgba(138, 83, 64, 0.16), transparent 68%),
    #f6f0e6;
}

.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cup {
  position: relative;
  width: 620rpx;
  height: 640rpx;
  transform-origin: 50% 78%;
}

.cup.shake {
  animation: shake 0.18s linear infinite;
}

@keyframes shake {
  0% { transform: rotate(-7deg) translateX(-12rpx); }
  50% { transform: rotate(7deg) translateX(12rpx); }
  100% { transform: rotate(-7deg) translateX(-12rpx); }
}

.sticks {
  position: absolute;
  left: 108rpx;
  right: 108rpx;
  bottom: 48rpx;
  height: 560rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-end;
  justify-content: center;
  z-index: 1;
}

.stick {
  flex: 1;
  min-width: 6rpx;
  max-width: 20rpx;
  margin: 0 3rpx;
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  transform: translateY(0);
  transition: transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: inset 0 0 0 1rpx rgba(255, 250, 243, 0.25);
}

.stick.up {
  transform: translateY(-150rpx);
}

.cup-body {
  position: absolute;
  left: 70rpx;
  right: 70rpx;
  bottom: 0;
  height: 280rpx;
  z-index: 2;
  border-radius: 36rpx 36rpx 90rpx 90rpx;
  background:
    linear-gradient(180deg, rgba(255, 236, 214, 0.2), rgba(255, 236, 214, 0) 28%),
    linear-gradient(90deg, #6e4332 0%, #8d5842 18%, #70432f 48%, #5a3424 100%);
  box-shadow:
    inset 0 16rpx 18rpx rgba(255, 236, 214, 0.18),
    0 24rpx 40rpx rgba(70, 36, 20, 0.22);
}

.cup-lip {
  height: 28rpx;
  margin: 0 8rpx;
  border-radius: 0 0 20rpx 20rpx;
  background: rgba(255, 236, 214, 0.16);
}

.slip-slot {
  min-height: 168rpx;
}
