.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(80% 50% at 50% 18%, rgba(216, 90, 58, 0.12), transparent 70%),
    #f6f0e6;
}

.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wheel-box {
  position: relative;
  width: 620rpx;
  height: 680rpx;
}

.pointer {
  position: absolute;
  top: 6rpx;
  left: 50%;
  z-index: 4;
  width: 0;
  height: 0;
  margin-left: -22rpx;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-top: 52rpx solid #d85a3a;
  filter: drop-shadow(0 8rpx 6rpx rgba(90, 30, 16, 0.18));
}

.wheel-shadow {
  position: absolute;
  left: 18rpx;
  top: 58rpx;
  width: 584rpx;
  height: 584rpx;
  border-radius: 50%;
  background: rgba(48, 28, 16, 0.08);
}

.wheel-canvas {
  position: absolute;
  left: 0;
  top: 24rpx;
  width: 620rpx;
  height: 620rpx;
}

.slip-slot {
  min-height: 168rpx;
  padding-bottom: 8rpx;
}
