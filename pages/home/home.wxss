.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(120% 60% at 100% -10%, rgba(216, 90, 58, 0.14), transparent 55%),
    radial-gradient(90% 50% at -10% 20%, rgba(47, 111, 94, 0.12), transparent 50%),
    #f6f0e6;
}

.scroll {
  flex: 1;
  height: 0;
}

.content {
  padding: 20rpx 32rpx 48rpx;
}

.intro-kicker {
  display: block;
  font-size: 22rpx;
  letter-spacing: 6rpx;
  color: #d85a3a;
}

.intro-title {
  display: block;
  margin-top: 12rpx;
  font-size: 64rpx;
  line-height: 1.15;
  font-weight: 600;
  color: #221e1a;
}

.intro-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #7a7168;
}

.methods {
  display: flex;
  flex-direction: row;
  margin-top: 36rpx;
}

.method {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  padding: 22rpx 8rpx 20rpx;
  border-radius: 32rpx;
  background: rgba(255, 250, 243, 0.88);
  box-shadow: 0 12rpx 30rpx rgba(48, 32, 20, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.method:last-child {
  margin-right: 0;
}

.method.on {
  background: #221e1a;
  box-shadow: 0 16rpx 32rpx rgba(34, 30, 26, 0.18);
}

.method-hover {
  opacity: 0.86;
}

.method-name {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #221e1a;
}

.method-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8d847a;
}

.method.on .method-name,
.method.on .method-desc {
  color: #fffaf3;
}

.method.on .method-desc {
  color: rgba(255, 250, 243, 0.62);
}

.mini-wheel {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: conic-gradient(#d85a3a 0 100deg, #e0a106 100deg 190deg, #2f6f5e 190deg 280deg, #3d5a80 280deg 360deg);
  box-shadow: inset 0 0 0 8rpx #fffaf3;
}

.method.on .mini-wheel {
  box-shadow: inset 0 0 0 8rpx #221e1a;
}

.mini-cards {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
}

.mini-card {
  width: 36rpx;
  height: 50rpx;
  border-radius: 8rpx;
  background: #fffaf3;
  border: 3rpx solid #d85a3a;
  transform: rotate(-10deg);
}

.mini-card.front {
  margin-left: -14rpx;
  background: #d85a3a;
  border-color: #d85a3a;
  transform: rotate(8deg);
}

.mini-cup {
  width: 72rpx;
  height: 72rpx;
  position: relative;
}

.mini-body {
  position: absolute;
  left: 10rpx;
  right: 10rpx;
  bottom: 6rpx;
  height: 36rpx;
  border-radius: 8rpx 8rpx 18rpx 18rpx;
  background: #8a5340;
  z-index: 2;
}

.mini-stick {
  position: absolute;
  bottom: 18rpx;
  width: 6rpx;
  border-radius: 6rpx;
  z-index: 1;
}

.mini-stick.a {
  left: 22rpx;
  height: 40rpx;
  background: #e0a106;
}

.mini-stick.b {
  left: 34rpx;
  height: 52rpx;
  background: #d85a3a;
}

.mini-stick.c {
  left: 46rpx;
  height: 36rpx;
  background: #2f6f5e;
}

.section-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  margin: 48rpx 8rpx 18rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #221e1a;
}

.section-meta {
  font-size: 24rpx;
  color: #9a9188;
}

.opt {
  margin-bottom: 16rpx;
  padding: 8rpx 8rpx 8rpx 0;
  border-radius: 28rpx;
  background: rgba(255, 250, 243, 0.92);
  box-shadow: 0 10rpx 28rpx rgba(48, 32, 20, 0.045);
}

.opt-main {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 96rpx;
}

.opt-index {
  width: 72rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
  color: #b0a69c;
}

.opt-input {
  flex: 1;
  height: 96rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  font-size: 32rpx;
  color: #221e1a;
}

.opt-ph {
  color: #c4bbb2;
  font-size: 30rpx;
}

.opt-remove {
  padding: 12rpx 18rpx;
  font-size: 24rpx;
  color: #9a9188;
}

.bias {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 20rpx 16rpx 72rpx;
}

.track {
  position: relative;
  flex: 1;
  height: 48rpx;
}

.track-rail,
.track-fill {
  position: absolute;
  left: 0;
  top: 18rpx;
  height: 12rpx;
  border-radius: 999rpx;
}

.track-rail {
  right: 0;
  background: #efe4d6;
}

.knob {
  position: absolute;
  top: 24rpx;
  width: 34rpx;
  height: 34rpx;
  margin-left: -17rpx;
  border-radius: 50%;
  background: #fffaf3;
  border: 5rpx solid #d85a3a;
  box-shadow: 0 6rpx 12rpx rgba(34, 30, 26, 0.16);
}

.pct {
  width: 84rpx;
  text-align: right;
  font-size: 24rpx;
  font-weight: 600;
  color: #5f574f;
}

.add {
  height: 96rpx;
  margin-top: 8rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  border: 2rpx dashed rgba(34, 30, 26, 0.16);
  color: #6a625a;
  font-size: 28rpx;
  background: rgba(255, 250, 243, 0.45);
}

.add-hover {
  background: #fffaf3;
}

.add-plus {
  margin-right: 10rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #d85a3a;
}

.limit,
.even {
  margin-top: 18rpx;
  text-align: center;
  font-size: 24rpx;
  color: #9a9188;
}

.even {
  color: #d85a3a;
}
