.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(90% 40% at 0% 0%, rgba(61, 90, 128, 0.1), transparent 55%),
    #f4efe6;
}

.scroll {
  flex: 1;
  height: 0;
}

.grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  padding: 28rpx 24rpx 12rpx;
}

.card {
  margin: 10rpx;
  height: 240rpx;
  perspective: 900rpx;
}

.cols-2 .card {
  width: calc(50% - 20rpx);
  height: 440rpx;
}

.cols-3 .card {
  width: calc(33.33% - 20rpx);
  height: 300rpx;
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.card.flipped .card-inner {
  transform: rotateY(180deg);
}

.face {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 18rpx;
  backface-visibility: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #f7f3ea;
  box-shadow: 0 14rpx 28rpx rgba(48, 24, 16, 0.16);
}

.face-back {
  padding: 12rpx;
}

.back-mat {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
  overflow: hidden;
  background-color: #8f1c30;
  background-image:
    radial-gradient(circle at 50% 50%, rgba(255, 236, 210, 0.16) 0 16%, transparent 17%),
    repeating-linear-gradient(45deg, rgba(243, 214, 164, 0.28) 0 2rpx, transparent 2rpx 18rpx),
    repeating-linear-gradient(-45deg, rgba(243, 214, 164, 0.28) 0 2rpx, transparent 2rpx 18rpx);
  box-shadow: inset 0 0 0 4rpx rgba(243, 214, 164, 0.92);
}

.back-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 78rpx;
  height: 104rpx;
  margin-left: -39rpx;
  margin-top: -52rpx;
  border-radius: 40rpx;
  border: 3rpx solid rgba(243, 214, 164, 0.95);
  background: rgba(98, 12, 26, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-gem {
  width: 22rpx;
  height: 22rpx;
  background: #f3d6a4;
  transform: rotate(45deg);
}

.cols-3 .back-core {
  width: 52rpx;
  height: 70rpx;
  margin-left: -26rpx;
  margin-top: -35rpx;
  border-radius: 28rpx;
}

.cols-3 .back-gem {
  width: 16rpx;
  height: 16rpx;
}

.card-hover {
  transform: translateY(-6rpx);
}

.face-front {
  transform: rotateY(180deg);
  padding: 16rpx;
}

.front-line {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  right: 16rpx;
  bottom: 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(143, 28, 48, 0.45);
}

.face-text {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  color: #221e1a;
  word-break: break-all;
}

.card.dim {
  opacity: 0.38;
}

.slip-slot {
  min-height: 168rpx;
}
